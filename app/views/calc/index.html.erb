<!DOCTYPE html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7"> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8"> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9"> <![endif]-->
<!--[if gt IE 8]>      <html class="no-js"> <!--<![endif]-->
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>calc</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="">
</head>

<body>
    <h1>calc</h1>
    <p>Welcome to calc</p>
    <%= form_with url: '/calc', method: :post do |form| %>
    <div>
        <%= form.label :number1, 'Number 1:' %>
        <%= form.number_field :number1 %>
    </div>
    <div>
        <%= form.label :number2, 'Number 2:' %>
        <%= form.number_field :number2 %>
    </div>
    <div>
        <%= form.label :operation, 'Operation:' %>
        <%= form.select :operation, options_for_select([['Add', 'add'], ['Subtract', 'subtract'], ['Multiply', 'multiply'], ['Divide', 'divide']]) %>
    </div>
    <div>
        <%= form.submit 'Calculate' %> <%= link_to "Calculate", calculate_calc_index_path %>
    </div>
    <% end %>
    <% if defined?(@result) && @result.present? %>
    <h2>Result: <%= @result %></h2>
    <% end %>
     


    <script src="" async defer></script>
</body>

</html>